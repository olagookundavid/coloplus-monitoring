# Copy to ~/apps/coloplus/.env on the server (deploy/README.md §2,
# deploy/CHECKLIST.md B5), then chmod 600 it. Fill in every REPLACE_ME
# placeholder by hand -- never commit the real values.

APP_NAME=coloplus
APP_ENV=production
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=20s

# Shared Postgres container on the `database` network, this product's
# least-privilege user (deploy/README.md §2 creates it). Password is the one
# saved to ~/infra/postgres/coloplus-db-password.txt (CHECKLIST B3).
DATABASE_URL=postgres://coloplus:REPLACE_ME_DB_PASSWORD@postgres:5432/coloplus?sslmode=disable
# This product's share of the shared Postgres max_connections.
DB_MAX_CONNS=8
DB_MIN_CONNS=1
DB_TIMEZONE=Africa/Lagos

# Exactly 32 characters, two different `openssl rand -hex 16` values
# (CHECKLIST B5). Save SECRETS_KEY to the password manager -- losing it
# disables everyone's two-step login.
TOKEN_SYMMETRIC_KEY=REPLACE_ME_32_CHARS_TOKEN_SYMMETRIC_KEY
AUTH_COOKIE_NAME=coloplus_access_token
ACCESS_TOKEN_TTL=12h
SECRETS_KEY=REPLACE_ME_32_CHARS_SECRETS_KEY_DIFFERENT
# api.remotems.com and www.remotems.com are both on the remotems.com zone,
# so the cookie stays same-site (lax) -- the whole reason the front end
# origin was kept on this zone instead of a vercel.app domain (CHECKLIST A7).
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=.remotems.com
BCRYPT_COST=12
MFA_ISSUER=Coloplus
REPORTING_TIMEZONE=Africa/Lagos

# The decided front end origin (CHECKLIST A7). Comma-separated explicit
# origins, never *.
CORS_ALLOW_ORIGINS=https://www.remotems.com

RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_BURST=5

WORKER_POOL_SIZE=8
WORKER_POOL_QUEUE=64

AUDIT_BATCH_SIZE=20
AUDIT_BATCH_INTERVAL=5s
AUDIT_QUEUE_SIZE=1000

# Private bucket for evidence files. Use a token scoped to this bucket only
# (not the backup bucket). Then run once: docker exec coloplus-backend /app/server check-storage
R2_ACCOUNT_ID=REPLACE_ME_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_ME_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_ME_R2_SECRET_ACCESS_KEY
R2_BUCKET=REPLACE_ME_BUCKET_NAME
# Switch on once check-storage passes and you have looked at what the dry run reports.
ATTACHMENT_GC_ENABLED=false

# Production refuses to start with MAIL_PROVIDER=log. The sending domain
# must already show "Verified" in Resend (CHECKLIST A5/A6) before this works.
MAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE_ME_RESEND_API_KEY
MAIL_FROM="Coloplus <alerts@remotems.com>"
MAIL_RATE_PER_SECOND=8
MAIL_TIMEOUT=10s
# Where the front end lives. Links in emails point here.
APP_BASE_URL=https://www.remotems.com

JOB_DISPATCH_EMAILS_CRON=* * * * *
JOB_INCIDENT_ALERTS_CRON=*/10 * * * *
JOB_REPORT_ALERTS_CRON=*/30 * * * *
JOB_ACCEPTANCE_ALERTS_CRON=*/30 * * * *

# Must be false in production.
SWAGGER_ENABLED=false
