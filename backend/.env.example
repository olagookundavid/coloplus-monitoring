# Copy to backend/.env for local development. Never commit the real file.

APP_NAME=coloplus
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=20s

# Local Postgres from `make db/up`. In production this is the shared server's
# per-product database and least-privilege user.
DATABASE_URL=postgres://coloplus:coloplus@127.0.0.1:5432/coloplus?sslmode=disable
# This product's share of the shared Postgres max_connections.
DB_MAX_CONNS=8
DB_MIN_CONNS=1
DB_TIMEZONE=Africa/Lagos

# Exactly 32 characters. Generate with: openssl rand -hex 16
TOKEN_SYMMETRIC_KEY=change-me-change-me-change-me-12
# Required. Name of the browser cookie that carries the access token.
AUTH_COOKIE_NAME=coloplus_access_token
ACCESS_TOKEN_TTL=12h
# Exactly 32 characters, different from TOKEN_SYMMETRIC_KEY. Encrypts
# authenticator-app seeds at rest. Losing it disables everyone's two-step login.
SECRETS_KEY=change-me-too-change-me-too-1234
# lax or strict when the front end shares a site with the API; none (needs
# AUTH_COOKIE_SECURE=true) when it is served from another site such as Vercel.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
BCRYPT_COST=12
MFA_ISSUER=Coloplus
# Defines the reporting day (day boundaries); the DB session zone is separate.
REPORTING_TIMEZONE=Africa/Lagos

# Comma-separated explicit origins, never *.
CORS_ALLOW_ORIGINS=http://localhost:5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30
# Sign-in attempts per client IP.
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_BURST=5

WORKER_POOL_SIZE=8
WORKER_POOL_QUEUE=64

# Audit batching: flush at N events or T, whichever comes first.
AUDIT_BATCH_SIZE=20
AUDIT_BATCH_INTERVAL=5s
AUDIT_QUEUE_SIZE=1000

# Email. MAIL_PROVIDER=log prints emails (with their links) to the log and is
# refused in production. With resend, the sender domain must be verified in
# Resend and match the domain of APP_BASE_URL's links where possible.
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM="Coloplus <alerts@your-verified-domain.example>"
MAIL_RATE_PER_SECOND=8
MAIL_TIMEOUT=10s
# Where the front end lives. Links in emails point here: /accept-invite and
# /reset-password (each with ?token=) and /incidents/<id>.
APP_BASE_URL=http://localhost:5173

# Scheduled jobs, five-field cron.
JOB_DISPATCH_EMAILS_CRON=* * * * *
JOB_INCIDENT_ALERTS_CRON=*/10 * * * *

# Swagger UI at /swagger/index.html. Must be false in production.
SWAGGER_ENABLED=true
