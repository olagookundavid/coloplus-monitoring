# Copy to backend/.env for local development. Never commit the real file.

APP_NAME=coloplus
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=20s

# Local Postgres from `make db/up`. In production this is the shared server's
# per-product database and least-privilege user.
DATABASE_URL=postgres://coloplus:coloplus@127.0.0.1:5432/coloplus?sslmode=disable
# This product's share of the shared Postgres max_connections.
DB_MAX_CONNS=8
DB_MIN_CONNS=1
DB_TIMEZONE=Africa/Lagos

# Exactly 32 characters. Generate with: openssl rand -hex 16
TOKEN_SYMMETRIC_KEY=change-me-change-me-change-me-12
# Required. Name of the browser cookie that carries the access token.
AUTH_COOKIE_NAME=coloplus_access_token
ACCESS_TOKEN_TTL=12h
# Exactly 32 characters, different from TOKEN_SYMMETRIC_KEY. Encrypts
# authenticator-app seeds at rest. Losing it disables everyone's two-step login.
SECRETS_KEY=change-me-too-change-me-too-1234
# lax or strict when the front end shares a site with the API; none (needs
# AUTH_COOKIE_SECURE=true) when it is served from another site such as Vercel.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
BCRYPT_COST=12
MFA_ISSUER=Coloplus
# Defines the reporting day (day boundaries); the DB session zone is separate.
REPORTING_TIMEZONE=Africa/Lagos

# Comma-separated explicit origins, never *.
CORS_ALLOW_ORIGINS=http://localhost:5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30
# Sign-in attempts per client IP.
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_BURST=5

WORKER_POOL_SIZE=8
WORKER_POOL_QUEUE=64

# Audit batching: flush at N events or T, whichever comes first.
AUDIT_BATCH_SIZE=20
AUDIT_BATCH_INTERVAL=5s
AUDIT_QUEUE_SIZE=1000

# Email. # Private file storage (Cloudflare R2) for evidence. Optional: leave all four
# empty and the file endpoints answer "not set up yet". Set all four or none.
# After setting them run: go run ./cmd/api check-storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# ATTACHMENT_MAX_MB=10
# Off by default: the cleanup job only reports abandoned uploads it would delete.
# ATTACHMENT_GC_ENABLED=false

# How long identical dashboard questions share an answer (0 turns it off).
# Resend webhook signing secret ("whsec_..."), to mark bounced emails. Optional.
# RESEND_WEBHOOK_SECRET=
# DASHBOARD_CACHE_TTL=10s
# Estimated run time left (hours) at or under which a tank counts as low and an email goes out.
# FUEL_LOW_HOURS=24
# Availability target in percent; 0 means none is set and nothing is judged. Default is the recommended 99.5.
# SLA_TARGET_PERCENT=99.5
# SLA_AT_RISK_POINTS=0.2
# Days after a month ends before an administrator may close it.
# PERIOD_CLOSE_GRACE_DAYS=5
# An outage still going at midnight is assumed to continue until a report says otherwise.
# MIDNIGHT_CARRY_OVER=true
# MAINTENANCE_NOTICE_HOURS=48
# MAINTENANCE_MAX_HOURS=8
# MAINTENANCE_MONTHLY_CAP_HOURS=12
# Hours Coloplus has to respond to a dispute waiting on it; 0 turns the alert off.
# DISPUTE_RESPONSE_HOURS=72
# Days an acceptance may stay overdue before the administrators are told too; 0 turns it off.
# ACCEPTANCE_ESCALATE_DAYS=7
# Old emails lose their address and text after this many days; RETENTION_ENABLED=false only reports.
# NOTIFICATION_RETENTION_DAYS=90
# RETENTION_ENABLED=true
# JOB_RETENTION_CRON=37 3 * * *

# MAIL_PROVIDER=log prints emails (with their links) to the log and is
# refused in production. With resend, the sender domain must be verified in
# Resend and match the domain of APP_BASE_URL's links where possible.
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM="Coloplus <alerts@your-verified-domain.example>"
MAIL_RATE_PER_SECOND=8
MAIL_TIMEOUT=10s
# Where the front end lives. Links in emails point here: /accept-invite and
# /reset-password (each with ?token=) and /incidents/<id>.
APP_BASE_URL=http://localhost:5173

# Scheduled jobs, five-field cron.
JOB_DISPATCH_EMAILS_CRON=* * * * *
JOB_INCIDENT_ALERTS_CRON=*/10 * * * *
JOB_REPORT_ALERTS_CRON=*/30 * * * *
JOB_ACCEPTANCE_ALERTS_CRON=*/30 * * * *
# The Monday summary email. On by default; each user can opt out.
WEEKLY_DIGEST_ENABLED=true
JOB_WEEKLY_DIGEST_CRON=0 7 * * 1

# Swagger UI at /swagger/index.html. Must be false in production.
SWAGGER_ENABLED=true

