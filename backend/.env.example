# Copy to backend/.env for local development. Never commit the real file.

APP_NAME=coloplus
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=20s

# Local Postgres from `make db/up`. In production this is the shared server's
# per-product database and least-privilege user.
DATABASE_URL=postgres://coloplus:coloplus@127.0.0.1:5432/coloplus?sslmode=disable
# This product's share of the shared Postgres max_connections.
DB_MAX_CONNS=8
DB_MIN_CONNS=1
DB_TIMEZONE=Africa/Lagos

# Exactly 32 characters. Generate with: openssl rand -hex 16
TOKEN_SYMMETRIC_KEY=change-me-change-me-change-me-12
# Required. Name of the browser cookie that carries the access token.
AUTH_COOKIE_NAME=coloplus_access_token
ACCESS_TOKEN_TTL=12h

# Comma-separated explicit origins, never *.
CORS_ALLOW_ORIGINS=http://localhost:5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30

WORKER_POOL_SIZE=8
WORKER_POOL_QUEUE=64

# Audit batching: flush at N events or T, whichever comes first.
AUDIT_BATCH_SIZE=20
AUDIT_BATCH_INTERVAL=5s
AUDIT_QUEUE_SIZE=1000

# Swagger UI at /swagger/index.html. Must be false in production.
SWAGGER_ENABLED=true
